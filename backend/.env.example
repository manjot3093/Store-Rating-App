# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_ratings
DB_USER=postgres
DB_PASSWORD=12345678

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Default admin (used by the seed script)
ADMIN_NAME=System Administrator Account
ADMIN_EMAIL=admin@storeratings.com
ADMIN_PASSWORD=Admin@1234
ADMIN_ADDRESS=Head Office, Platform HQ, City Center, Country
